{
  "name": "klennybrain",
  "version": "0.1.0",
  "private": true,
  "description": "KlennyBrain: a Company Brain built on HydraDB and digohq/app-starter (NestJS, Next.js, Prisma)",
  "scripts": {
    "prepare": "husky",
    "bootstrap": "bash ./scripts/bootstrap.sh",
    "env:init": "node scripts/init-env.mjs",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "start:api": "pnpm --filter @app-starter/api run start:prod",
    "start:web": "pnpm --filter @app-starter/web run start",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "verify": "turbo run type-check lint test",
    "test:cov": "turbo run test:cov",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,css,mjs,cjs}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,css,mjs,cjs}\" --ignore-path .gitignore"
  },
  "dependencies": {
    "husky": "^9.1.7"
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "turbo": "^2.11.7",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.26.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=8.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "bcrypt",
      "prisma",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "@types/react": "^19.0.0",
      "@types/react-dom": "^19.0.0"
    }
  }
}
