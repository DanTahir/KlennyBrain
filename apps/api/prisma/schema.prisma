// ============================================================================
// App Starter schema
//
// Identity, multi-tenancy, custom domains and notifications from app-starter,
// plus the KlennyBrain "Company Brain" models at the bottom of the file.
// There is no billing here on purpose — see
// docs/adr/0008-no-billing-in-the-starter.md.
//
// `Organization` is the tenant. Every organization-scoped model carries an
// `organizationId` and is indexed on it, and every query filters by it. See
// docs/adr/0006-single-database-multi-tenancy.md.
//
// Conventions: timestamps are `@db.Timestamptz(6)`, columns are snake_case via
// `@map`, tables are pluralised via `@@map`.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// Identity
// ============================================================================

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  password        String? // Hashed; nullable for OAuth/OTP-only signups
  name            String?
  username        String?   @unique
  avatarUrl       String?   @map("avatar_url")
  bio             String?
  timezone        String? // IANA identifier, e.g. "America/New_York"
  emailVerifiedAt DateTime? @db.Timestamptz(6)
  lastLoginAt     DateTime? @db.Timestamptz(6)
  quarantinedAt   DateTime? @db.Timestamptz(6)
  isGlobalAdmin   Boolean   @default(false) @map("is_global_admin")

  // Google OAuth
  googleId       String?   @unique @map("google_id")
  googleEmail    String?   @map("google_email")
  googleName     String?   @map("google_name")
  googlePicture  String?   @map("google_picture")
  googleLinkedAt DateTime? @map("google_linked_at")

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  // Relations
  memberships             OrganizationMember[]
  emailVerifications      UserEmailVerification[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  inAppNotifications      InAppNotification[]
  conversations           Conversation[]
  requestedActions        AgentAction[]            @relation("ActionRequester")
  approvedActions         AgentAction[]            @relation("ActionApprover")

  adminImpersonationAudits AdminImpersonationAudit[] @relation("AdminImpersonationTargetUser")
  quarantinedAudits        AdminQuarantineAudit[]    @relation("QuarantinedUser")
  quarantineActions        AdminQuarantineAudit[]    @relation("QuarantineAdmin")

  @@index([isGlobalAdmin])
  @@index([username])
  @@map("users")
}

model UserEmailVerification {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  email     String
  expiresAt DateTime  @db.Timestamptz(6) // 24h from createdAt
  usedAt    DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("user_email_verifications")
}

// ============================================================================
// Platform administration
// ============================================================================

model AdminImpersonationAudit {
  id           String   @id @default(uuid())
  actor        String
  targetUserId String   @map("target_user_id")
  reason       String
  jti          String   @unique
  ip           String?
  userAgent    String?  @map("user_agent")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  targetUser User @relation("AdminImpersonationTargetUser", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([targetUserId, createdAt])
  @@map("admin_impersonation_audits")
}

model AdminQuarantineAudit {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  adminId   String   @map("admin_id")
  action    String // 'QUARANTINE' | 'UNQUARANTINE'
  reason    String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user  User @relation("QuarantinedUser", fields: [userId], references: [id])
  admin User @relation("QuarantineAdmin", fields: [adminId], references: [id])

  @@index([userId])
  @@index([adminId])
  @@map("admin_quarantine_audits")
}

// ============================================================================
// Multi-tenancy
// ============================================================================

enum OrgRole {
  OWNER // Full control incl. billing and deletion; assigned to creator
  ADMIN // Can manage members, settings, and invites
  MEMBER // Default role for invitees
}

model Organization {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?
  website     String?
  location    String?
  timezone    String? // IANA identifier
  logoUrl     String? @map("logo_url")

  // Outbound email identity for this tenant
  emailReplyTo    String? @map("email_reply_to")
  emailSenderName String? @map("email_sender_name")

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  members                 OrganizationMember[]
  invites                 OrganizationInvite[]
  domainMappings          DomainMapping[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  brainSpace              BrainSpace?
  sources                 Source[]
  syncJobs                SyncJob[]
  knowledgeItems          KnowledgeItem[]
  directoryPeople         DirectoryPerson[]
  conversations           Conversation[]
  insights                Insight[]
  agentActions            AgentAction[]

  @@map("organizations")
}

model OrganizationMember {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  organizationId String   @map("organization_id")
  role           OrgRole
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
  @@index([userId, role, organizationId])
  @@map("organization_members")
}

enum InviteStatus {
  PENDING
  ACCEPTED
  CANCELLED
  EXPIRED // Calculated, not stored
}

model OrganizationInvite {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  token          String       @unique
  email          String? // Null for reusable link invites
  isReusable     Boolean      @default(false) @map("is_reusable")
  /// Role assigned on acceptance; immutable after send
  invitedRole    OrgRole      @default(MEMBER) @map("invited_role")
  expiresAt      DateTime     @db.Timestamptz(6)
  status         InviteStatus @default(PENDING)
  createdBy      String       @map("created_by")
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(6)

  organization       Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  emailVerifications InviteEmailVerification[]

  @@index([token])
  @@index([organizationId, status])
  @@map("organization_invites")
}

model InviteEmailVerification {
  id        String    @id @default(uuid())
  inviteId  String    @map("invite_id")
  token     String    @unique
  email     String
  name      String?
  expiresAt DateTime  @db.Timestamptz(6) // 24h from createdAt
  usedAt    DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)

  invite OrganizationInvite @relation(fields: [inviteId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([inviteId])
  @@map("invite_email_verifications")
}

// ============================================================================
// Custom domains
// ============================================================================

enum DomainVerificationStatus {
  PENDING // Awaiting DNS configuration
  VERIFIED // DNS TXT record confirmed
  FAILED // Record missing or incorrect
}

model DomainMapping {
  id                 String                   @id @default(uuid())
  organizationId     String                   @map("organization_id")
  domain             String                   @unique // Lowercase hostname
  verificationStatus DomainVerificationStatus @default(PENDING) @map("verification_status")
  verificationToken  String                   @unique @map("verification_token") // UUID for DNS TXT record
  verifiedAt         DateTime?                @map("verified_at") @db.Timestamptz(6)
  errorMessage       String?                  @map("error_message")

  // Per-domain white-label branding
  customLogoUrl    String? @map("custom_logo_url")
  logoHeight       Int?    @map("logo_height")
  customFaviconUrl String? @map("custom_favicon_url")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([domain])
  @@index([organizationId])
  @@index([verificationStatus])
  @@map("domain_mappings")
}

// ============================================================================
// Notifications
// ============================================================================

enum NotificationType {
  TRANSACTIONAL
  SYSTEM
}

enum NotificationChannel {
  EMAIL
  SMS
  PUSH
  IN_APP
}

enum NotificationStatus {
  PENDING
  QUEUED
  SENT
  FAILED
}

model Notification {
  id                String              @id @default(cuid())
  type              NotificationType
  channel           NotificationChannel
  definitionName    String              @map("definition_name")
  recipient         Json
  recipientEmail    String?             @map("recipient_email")
  recipientPhone    String?             @map("recipient_phone")
  subject           String?
  variables         Json?
  status            NotificationStatus
  providerMessageId String?             @map("provider_message_id")
  organizationId    String?             @map("organization_id")
  userId            String?             @map("user_id")

  sentAt       DateTime? @map("sent_at") @db.Timestamptz(6)
  deliveredAt  DateTime? @map("delivered_at") @db.Timestamptz(6)
  openedAt     DateTime? @map("opened_at") @db.Timestamptz(6)
  clickedAt    DateTime? @map("clicked_at") @db.Timestamptz(6)
  failedAt     DateTime? @map("failed_at") @db.Timestamptz(6)
  errorCode    String?   @map("error_code")
  errorMessage String?   @map("error_message")
  metadata     Json?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id])

  @@index([recipientEmail, status])
  @@index([recipientPhone, status])
  @@index([type, channel, status])
  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
  @@index([providerMessageId])
  @@index([definitionName])
  @@map("notifications")
}

model NotificationPreference {
  id             String              @id @default(cuid())
  userId         String              @map("user_id")
  organizationId String?             @map("organization_id")
  channel        NotificationChannel
  type           NotificationType
  enabled        Boolean             @default(true)
  definitionName String?             @map("definition_name")
  category       String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId, channel, type, definitionName])
  @@index([userId, organizationId])
  @@index([userId, category])
  @@index([definitionName])
  @@map("notification_preferences")
}

model InAppNotification {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  type        String // 'invitation' | 'acceptance' | 'billing' | 'system'
  title       String
  description String
  data        Json
  read        Boolean   @default(false)
  dismissed   Boolean   @default(false)
  createdAt   DateTime  @default(now()) @map("created_at")
  readAt      DateTime? @map("read_at")
  dismissedAt DateTime? @map("dismissed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, read])
  @@index([createdAt])
  @@map("in_app_notifications")
}

// ============================================================================
// Utilities
// ============================================================================

model ShortLink {
  id          String  @id @default(uuid())
  slug        String  @unique
  targetUrl   String  @map("target_url")
  description String?

  /// Optional linkage for cleanup when the referenced record is deleted
  entityId   String? @map("entity_id")
  entityType String? @map("entity_type")

  clicks    Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([slug])
  @@map("short_links")
}

// ============================================================================
// Company Brain
//
// One BrainSpace per organization maps to one HydraDB database. Sources feed
// KnowledgeItems (mirrors of what was ingested into HydraDB). Conversations
// hold Ask history; Insights and AgentActions hold derived findings and
// human-approved side effects.
// ============================================================================

enum BrainSpaceStatus {
  NOT_PROVISIONED
  PROVISIONING
  READY
  ERROR
}

model BrainSpace {
  id             String           @id @default(uuid())
  organizationId String           @unique @map("organization_id")
  hydraDatabase  String           @map("hydra_database")
  collection     String           @default("default")
  status         BrainSpaceStatus @default(NOT_PROVISIONED)
  error          String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("brain_spaces")
}

enum SourceType {
  DEMO
  SLACK
  GITHUB
}

enum SourceStatus {
  IDLE
  SYNCING
  READY
  ERROR
}

model Source {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  type           SourceType
  name           String
  status         SourceStatus @default(IDLE)
  /// Non-secret configuration only (e.g. data path, Slack team id).
  config         Json?
  itemCount      Int          @default(0) @map("item_count")
  lastSyncedAt   DateTime?    @map("last_synced_at") @db.Timestamptz(6)
  error          String?

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  syncJobs     SyncJob[]
  items        KnowledgeItem[]

  @@unique([organizationId, type, name])
  @@index([organizationId])
  @@map("sources")
}

enum SyncJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

model SyncJob {
  id             String        @id @default(uuid())
  organizationId String        @map("organization_id")
  sourceId       String        @map("source_id")
  status         SyncJobStatus @default(QUEUED)
  total          Int           @default(0)
  processed      Int           @default(0)
  failed         Int           @default(0)
  indexed        Int           @default(0)
  startedAt      DateTime?     @map("started_at") @db.Timestamptz(6)
  finishedAt     DateTime?     @map("finished_at") @db.Timestamptz(6)
  error          String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  source       Source       @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([sourceId, createdAt])
  @@map("sync_jobs")
}

model KnowledgeItem {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  sourceId       String    @map("source_id")
  hydraId        String    @map("hydra_id")
  kind           String
  sourceSystem   String    @map("source_system")
  provider       String
  externalId     String    @map("external_id")
  title          String
  body           String    @db.Text
  url            String?
  authorEmail    String?   @map("author_email")
  occurredAt     DateTime? @map("occurred_at") @db.Timestamptz(6)
  /// null = visible to everyone in the org; otherwise HydraDB ACL strings.
  acl            Json?
  metadata       Json?
  additional     Json?
  indexingStatus String    @default("queued") @map("indexing_status")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  source       Source       @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([organizationId, hydraId])
  @@index([organizationId, kind])
  @@index([sourceId])
  @@map("knowledge_items")
}

model DirectoryPerson {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  personKey      String   @map("person_key")
  email          String
  name           String
  title          String?
  department     String?
  managerEmail   String?  @map("manager_email")
  groups         String[]
  slackUserId    String?  @map("slack_user_id")
  expertise      String[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, email])
  @@index([organizationId, slackUserId])
  @@map("directory_people")
}

model Conversation {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  userId         String    @map("user_id")
  title          String

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages     ChatMessage[]

  @@index([organizationId, userId, updatedAt])
  @@map("conversations")
}

enum ChatRole {
  USER
  ASSISTANT
}

model ChatMessage {
  id              String   @id @default(uuid())
  conversationId  String   @map("conversation_id")
  organizationId  String   @map("organization_id")
  role            ChatRole
  content         String   @db.Text
  citations       Json?
  toolTrace       Json?    @map("tool_trace")
  graphPaths      Json?    @map("graph_paths")
  hydraRequestId  String?  @map("hydra_request_id")
  feedback        Int?
  feedbackComment String?  @map("feedback_comment")
  viewAsEmail     String?  @map("view_as_email")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([organizationId])
  @@map("chat_messages")
}

enum InsightType {
  CONTRADICTION
  STALE_DOC
  DECISION
  ACTION_ITEM
}

enum InsightStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum InsightSeverity {
  LOW
  MEDIUM
  HIGH
}

model Insight {
  id             String          @id @default(uuid())
  organizationId String          @map("organization_id")
  type           InsightType
  title          String
  summary        String          @db.Text
  severity       InsightSeverity @default(MEDIUM)
  status         InsightStatus   @default(OPEN)
  /// Citation[] supporting the insight.
  evidence       Json?
  entities       Json?
  ownerEmail     String?         @map("owner_email")
  dueAt          DateTime?       @map("due_at") @db.Timestamptz(6)
  occurredAt     DateTime?       @map("occurred_at") @db.Timestamptz(6)
  /// Stable key so re-running analysis upserts instead of duplicating.
  fingerprint    String

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actions      AgentAction[]

  @@unique([organizationId, fingerprint])
  @@index([organizationId, type, status])
  @@map("insights")
}

enum AgentActionType {
  CREATE_GITHUB_ISSUE
  POST_SLACK_MESSAGE
  UPDATE_KNOWLEDGE_DOC
  SEND_EMAIL
}

enum AgentActionStatus {
  PROPOSED
  APPROVED
  EXECUTED
  FAILED
  REJECTED
}

model AgentAction {
  id             String            @id @default(uuid())
  organizationId String            @map("organization_id")
  type           AgentActionType
  status         AgentActionStatus @default(PROPOSED)
  title          String
  summary        String            @db.Text
  payload        Json
  result         Json?
  error          String?
  conversationId String?           @map("conversation_id")
  insightId      String?           @map("insight_id")
  requestedById  String?           @map("requested_by_id")
  approvedById   String?           @map("approved_by_id")
  executedAt     DateTime?         @map("executed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  insight      Insight?     @relation(fields: [insightId], references: [id], onDelete: SetNull)
  requestedBy  User?        @relation("ActionRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  approvedBy   User?        @relation("ActionApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([organizationId, status, createdAt])
  @@index([insightId])
  @@map("agent_actions")
}
