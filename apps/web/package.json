{
  "name": "@app-starter/web",
  "version": "0.0.0",
  "private": true,
  "description": "App Starter Web - Next.js frontend",
  "scripts": {
    "build": "next build",
    "dev": "dotenv -e .env.local -e .env -- next dev",
    "dev:https": "dotenv -e .env.local -e .env -- sh -c 'NODE_TLS_REJECT_UNAUTHORIZED=0 next dev --experimental-https --experimental-https-key $SSL_KEY_PATH --experimental-https-cert $SSL_CERT_PATH'",
    "dev:clean": "pnpm clean && pnpm dev",
    "start": "dotenv -e .env.local -e .env -- next start",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --max-warnings 0",
    "type-check": "tsc --noEmit",
    "clean": "rimraf .next out dist",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage"
  },
  "dependencies": {
    "@app-starter/shared": "workspace:*",
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-alert-dialog": "^1.1.24",
    "@radix-ui/react-avatar": "^1.2.7",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-label": "^2.1.16",
    "@radix-ui/react-popover": "^1.2.0",
    "@radix-ui/react-radio-group": "^1.4.8",
    "@radix-ui/react-select": "^2.3.8",
    "@radix-ui/react-slot": "^1.4.0",
    "@radix-ui/react-switch": "^1.3.8",
    "@radix-ui/react-tabs": "^1.1.22",
    "@radix-ui/react-tooltip": "^1.3.0",
    "@tanstack/react-query": "^5.104.1",
    "@tiptap/extension-link": "^3.31.4",
    "@tiptap/extension-placeholder": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "input-otp": "^1.5.0",
    "isomorphic-dompurify": "^3.22.0",
    "lucide-react": "^0.561.0",
    "next": "^16.4.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-day-picker": "^8.10.1",
    "react-dom": "^19.3.0",
    "react-force-graph-2d": "^1.29.2",
    "react-hook-form": "^7.89.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "socket.io-client": "^4.8.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "autoprefixer": "^10.6.1",
    "dotenv-cli": "^7.4.2",
    "eslint": "^8.57.0",
    "eslint-config-next": "^16.4.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.5.2",
    "postcss": "^8.5.29",
    "prettier": "^3.9.9",
    "rimraf": "^6.1.3",
    "tailwindcss": "^3.4.7",
    "ts-jest": "^29.4.14",
    "typescript": "^5.5.4"
  }
}
